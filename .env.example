# ==============================================================================
# VectorMoon Studio - Production & Analytics Configuration
# ==============================================================================

# Google Analytics 4 Measurement ID
# Obtained from Google Analytics (Admin > Data Streams > Web Stream > Measurement ID)
# Example: G-XXXXXXXXXX
VITE_GA_ID=

# Google Search Console Verification Meta Tag Content
# Obtained from Google Search Console (Settings > Ownership verification > HTML tag)
# Example: abcdef1234567890_XYZ
VITE_GSC_VERIFICATION=

# Google Business Profile / Google Maps URL
# Obtained by sharing your verified Google Business Profile link or Google Maps link
# Example: https://maps.app.goo.gl/... or https://g.page/r/...
VITE_GBP_URL=
